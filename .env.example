# Bind localhost only. Do not expose this service on a public interface.
CHAT_DIRECTOR_HOST=127.0.0.1
CHAT_DIRECTOR_PORT=8787
CHAT_DIRECTOR_PUBLIC_URL=http://127.0.0.1:8787

# Optional override. If unset, a token is generated into data/control-token.
# CHAT_DIRECTOR_TOKEN=

# Local data root (sqlite, media, credentials). Never commit this directory.
CHAT_DIRECTOR_DATA_DIR=./data

# Higgsfield CLI binary (must already be installed and authenticated for live generation).
CHAT_DIRECTOR_HIGGSFIELD_BIN=higgsfield

# FFmpeg / ffprobe
CHAT_DIRECTOR_FFMPEG=ffmpeg
CHAT_DIRECTOR_FFPROBE=ffprobe

# MCP bridge
CHAT_DIRECTOR_URL=http://127.0.0.1:8787
